{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "version": "0.0.0",
     "rules": [
      {
       "id": "github-pat",
       "properties": {
        "tags": [
         "CWE-798"
        ]
       }
      },
      {
       "id": "aws-access-token",
       "properties": {
        "tags": [
         "CWE-798"
        ]
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "github-pat",
     "level": "error",
     "message": {
      "text": "GitHub Personal Access Token"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "config.py"
        },
        "region": {
         "startLine": 2
        }
       }
      }
     ]
    },
    {
     "ruleId": "aws-access-token",
     "level": "error",
     "message": {
      "text": "AWS access key"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "config.py"
        },
        "region": {
         "startLine": 3
        }
       }
      }
     ]
    }
   ]
  }
 ]
}